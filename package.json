{
  "name": "codeck",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite web",
    "dev:mock": "vite web --mode mock",
    "build": "vite build web",
    "build:web": "vite build web --mode host",
    "typecheck": "tsc --noEmit -p web",
    "lint": "eslint web/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --root web",
    "test:e2e": "playwright test -c web/playwright.config.ts",
    "test:e2e:host": "playwright test -c web/playwright.host.config.ts",
    "tauri": "tauri",
    "bindings": "cargo test -p codeck --lib export_bindings -- --exact"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-deep-link": "2.6.2",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "anser": "2.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "diff": "9.0.0",
    "echarts": "6.1.0",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "^8.20.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
