#!/bin/sh
# Runs the checks for what a push brings (instead of CI): scripts/check.sh, which says what runs and
# skips what already passed on the same content — run it before pushing and the push is instant.
# It runs on the working tree, so it needs HEAD to be what is pushed and no uncommitted changes to
# tracked files. Skip once with `git push --no-verify`.
# Install: scripts/install-git-hooks.sh
set -u
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
zero=0000000000000000000000000000000000000000

changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref
  if [ "$(git rev-parse HEAD)" != "$local_sha" ]; then
    echo "pre-push: 推送的 $local_sha 不是当前 HEAD，检查只能在工作区跑。切到它再推，或 git push --no-verify。" >&2
    exit 1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  else
    changed="$changed
$(git ls-files)"
  fi
done
[ -n "$(echo "$changed" | tr -d '[:space:]')" ] || exit 0

list=$(mktemp -t codeck-pre-push)
echo "$changed" >"$list"
# exec: its parent stays git push, which it watches to stop when the push is gone.
exec "$root/scripts/check.sh" --hook "$list"
