#!/bin/sh
# Rejects a commit with Rust files that `cargo fmt` would change. Install: scripts/install-git-hooks.sh
git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$' || exit 0
if ! cargo fmt --all -- --check >/dev/null 2>&1; then
  echo "pre-commit: Rust 代码没有按 rustfmt 排版。运行 cargo fmt --all，再把改动 add 后重新提交。" >&2
  exit 1
fi
